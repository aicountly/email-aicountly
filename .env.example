# ---------------------------------------------------------------------------
# Aicountly Email — React build environment template
#
# Copy to .env for local development:   cp .env.example .env
# .env is git-ignored and is NEVER committed or deployed.
#
# IMPORTANT — these values are read at BUILD time, not at run time.
# Vite inlines every VITE_* value into the JavaScript bundle when the app is
# built. Putting a .env on the cPanel server has NO effect on an already-built
# app: the bundle is plain static JS and never reads a file from disk. To change
# one of these you must rebuild and redeploy.
# (server-php is the opposite — that backend reads its own .env at runtime. Its
# template is server-php/.env.example.)
#
# NEVER PUT A SECRET HERE. Anything VITE_* is public the moment the app is
# served. Mail-server passwords, model keys and service keys all live in
# server-php/.env and never leave the backend.
# ---------------------------------------------------------------------------

# --- API endpoint ----------------------------------------------------------
# WHICH API THIS APP CALLS IS NORMALLY RESOLVED AT RUNTIME, from the hostname
# the page was served from, so ONE build serves both destinations:
#
#   email.aicountly.com   -> same origin + /api
#   aicountly.io          -> https://email.apis.aicountly.com  (cross-origin)
#   email.gh.aicountly.com-> same origin + /api                (sandbox)
#
# Set VITE_API_BASE_URL only to point BOTH destinations at one backend — which
# is what you want once a single common Email API host is serving both.
VITE_API_BASE_URL=

# Per-destination overrides, if the two ever need different backends. Leave
# unset unless you have a reason; they defeat the point of one artifact.
# VITE_BUSINESS_API_BASE_URL=
# VITE_PERSONAL_API_BASE_URL=

# --- App identity ----------------------------------------------------------
VITE_APP_NAME=Email

# Deploy target this build is for: local | sandbox | production
VITE_APP_ENV=local

# Which experience localhost renders: business | personal.
# The production hostnames decide for themselves; this is development only.
VITE_DEV_FRONTEND_MODE=business

# --- Hostnames -------------------------------------------------------------
# The production and sandbox hosts are in web/src/config/frontend.ts and are
# deliberately hard-coded — an unrecognised host renders an error screen rather
# than the application. These add REVIEWED extra hosts at build time, which is a
# change to a deploy workflow rather than a wildcard in the code.
# VITE_EXTRA_BUSINESS_HOSTS=
# VITE_EXTRA_PERSONAL_HOSTS=

# --- Authentication --------------------------------------------------------
# Both are normally derived from the hostname and should stay unset. They exist
# for local development, where the hostname says nothing about the product.
#
# Portal authentication_jump product key.
# VITE_PRODUCT_KEY=email
#
# Login portal origin. Production is https://my.aicountly.com and sandbox is
# https://sandbox.aicountly.com; localhost uses the sandbox portal.
# NOTE: this is the login redirect only. The auth API (seskey, refresh,
# validatesession) is always my.aicountly.com — see docs/auth/.
# VITE_PORTAL_LOGIN_URL=https://sandbox.aicountly.com

# --- Analytics ---------------------------------------------------------------
# GA4 (gtag) measurement ID for this product, e.g. G-XXXXXXXXXX. Leave empty to
# disable analytics entirely (no script is injected).
VITE_GA4_SAAS_EMAIL_MEASUREMENT_ID=
#
# Generic fallback, used only if the product-specific ID above is unset.
# VITE_GA4_MEASUREMENT_ID=
