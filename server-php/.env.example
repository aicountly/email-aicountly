# ---------------------------------------------------------------------------
# Aicountly Email API — server environment template
#
# Unlike the React build, this file is read at RUNTIME on every request. It
# belongs on the server and only on the server:
#
#   1. Copy this file to <document root>/api/.env by hand, once (cPanel File
#      Manager or SSH).
#   2. It is git-ignored, and every rsync step passes --exclude='.env', so a
#      --delete deploy leaves it untouched.
#
# EVERY SECRET IN AICOUNTLY EMAIL LIVES HERE. Nothing below ever reaches the
# browser, appears in an API response, or is written to a log.
#
# See docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# Which deployment this is: production | sandbox | local
# Reported by GET /api/health, so you can tell the environments apart.
APP_ENV=production

# This product's own name, used when it calls a sibling product.
APP_PRODUCT_KEY=email

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# AICOUNTLY portal auth API. Leave unset unless you are pointing at a
# non-standard portal — my.aicountly.com serves BOTH production and sandbox.
# (sandbox.aicountly.com is a login redirect only; it does not serve seskey or
# validatesession.)
# PORTAL_AUTH_BASE=https://my.aicountly.com

# Extra origins allowed to call this API cross-origin, comma separated.
#
# The two production frontends and the two sandbox frontends are already
# allowed in code (server-php/index.php). This is for local development only:
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Service keys OTHER products present when they call Email, as app:key pairs.
# Each key must be at least 16 characters; a value still starting with
# CHANGE_ME never authenticates anything.
# SERVICE_KEYS=lobby:CHANGE_ME_LONG_RANDOM,appointments:CHANGE_ME_LONG_RANDOM

# ---------------------------------------------------------------------------
# Database — Email's OWN PostgreSQL schema, and nothing else.
#
# This connection reaches the email_* tables only. It is never pointed at
# Books, Inventory, Manage or any other product: their data is read live over
# their APIs. See docs/EMAIL_DATA_OWNERSHIP.md.
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=CHANGE_ME_email
DB_USER=CHANGE_ME_email_user
DB_PASS=CHANGE_ME
# DB_SCHEMA=public

# ---------------------------------------------------------------------------
# Mail store — where message bodies and attachments actually live.
#
# With none of this set, Email reports "no mail store is configured" on every
# screen that needs one. It does NOT show an empty inbox.
# ---------------------------------------------------------------------------
MAIL_STORE_DRIVER=imap
MAIL_IMAP_HOST=CHANGE_ME
MAIL_IMAP_PORT=993
# ssl | starttls | none
MAIL_IMAP_ENCRYPTION=ssl

# Preferred: one master credential for every mailbox (Dovecot's user*master
# form). Fewer secrets, and rotating one rotates everything.
MAIL_IMAP_MASTER_USER=
MAIL_IMAP_MASTER_PASSWORD=
# MAIL_IMAP_MASTER_SEPARATOR=*

# Only for a loopback test server. It is ignored for any other host, so a
# deployment cannot quietly disable certificate validation.
# MAIL_IMAP_ALLOW_INSECURE=0

# Folder names on this server.
MAIL_SENT_FOLDER=INBOX.Sent
MAIL_ARCHIVE_FOLDER=INBOX.Archive
MAIL_SPAM_FOLDER=INBOX.spam
MAIL_TRASH_FOLDER=INBOX.Trash

# ---------------------------------------------------------------------------
# Outbound transport
# ---------------------------------------------------------------------------
MAIL_TRANSPORT_DRIVER=smtp
MAIL_SMTP_HOST=CHANGE_ME
MAIL_SMTP_PORT=587
# tls (implicit, usually 465) | starttls (usually 587) | none
MAIL_SMTP_ENCRYPTION=starttls
MAIL_SMTP_USERNAME=CHANGE_ME
MAIL_SMTP_PASSWORD=CHANGE_ME
# MAIL_SMTP_HELO=email.aicountly.com
# MAIL_SMTP_ALLOW_INSECURE=0

# The right-hand side of generated Message-IDs. Defaults to the sender's domain.
# MAIL_MESSAGE_ID_DOMAIN=aicountly.com

# How long Send waits before the message actually goes out, in seconds (0-60).
# This is a REAL server-side hold, which is what makes Undo work.
MAIL_UNDO_SECONDS=10

# Largest attachment this API will serve, in bytes.
MAIL_MAX_ATTACHMENT_BYTES=26214400

# Set to 1 ONLY when a real delivery-status feed is connected. Until then Email
# reports "accepted by the outbound mail server" and never claims delivery.
MAIL_DSN_WEBHOOK_ENABLED=0

# Set to 1 ONLY when a real malware scanner is connected. Until then every
# attachment is shown as "not scanned", which is the truth.
MAIL_SCANNER_ENABLED=0

# The DKIM selector to look for when verifying a custom domain's DNS.
MAIL_DKIM_SELECTOR=default

# AES-256-GCM key (base64 of 32 random bytes) for per-mailbox credentials.
# Generate with:  openssl rand -base64 32
# With no key set, Email REFUSES to store a per-mailbox credential rather than
# falling back to plaintext. Use the IMAP master user instead.
MAIL_CREDENTIAL_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------
# Whether a signed-in AICOUNTLY user gets an Email account row on first sight.
# The ROW is Email's own bookkeeping; a MAILBOX still needs mail infrastructure.
EMAIL_AUTO_PROVISION_ACCOUNTS=1
EMAIL_DEFAULT_PLAN=free
EMAIL_DEFAULT_QUOTA_BYTES=2147483648
EMAIL_DEFAULT_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Pulse AI
#
# With no key set, every AI feature reports itself unavailable and the rules
# engine answers instead. The product does not degrade into nonsense.
# ---------------------------------------------------------------------------
EMAIL_AI_API_KEY=
# EMAIL_AI_MODEL=gemini-2.0-flash
# EMAIL_AI_ENDPOINT=

# ---------------------------------------------------------------------------
# Cross-product APIs
#
# Each base URL is derived from this deployment's own hostname when unset
# (sandbox talks to sandbox), so these are overrides. Set INTEGRATIONS_DERIVE_HOSTS=0
# to require every one of them explicitly.
# ---------------------------------------------------------------------------
INTEGRATIONS_DERIVE_HOSTS=1
# MANAGE_API_BASE=https://manage.aicountly.com
# PURCHASES_API_BASE=https://purchase.aicountly.com
# SALES_API_BASE=https://sales.aicountly.com
# BOOKS_API_BASE=https://books.aicountly.com
# INVENTORY_API_BASE=https://inventory.aicountly.com
# CALENDAR_API_BASE=https://calendar.aicountly.com
# CONTACTS_API_BASE=https://contacts.aicountly.com
# DRIVE_API_BASE=https://drive.aicountly.com
# PAY_API_BASE=https://pay.aicountly.com
# LOBBY_API_BASE=https://receptionist.aicountly.com
# APPOINTMENTS_API_BASE=https://appointments.aicountly.com
# HELPDESK_API_BASE=https://helpdesk.aicountly.com
# CONNECT_API_BASE=https://connect.aicountly.com
# VOICE_API_BASE=https://voice.aicountly.com

# Service keys EMAIL presents when it calls a sibling product, issued by that
# product. Only the ones Email actually writes to are needed.
# CALENDAR_SERVICE_KEY=CHANGE_ME
# DRIVE_SERVICE_KEY=CHANGE_ME
