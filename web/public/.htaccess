# ---------------------------------------------------------------------------
# Apache config for the built SPA on cPanel.
#
# Vite copies everything in public/ into dist/, so this ships with the build and
# the deploy workflow places it at the DOCUMENT ROOT — never inside
# releases/<sha>/, which must keep Apache's default behaviour so a missing asset
# there 404s instead of being answered with the application.
#
# This file is the product's own. It is deployed as a whole, so if the server
# carries hand-written rules as well, merge them here rather than editing the
# copy on the server — the next deploy overwrites that one.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Leave real files and directories alone.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Never swallow Let's Encrypt validation requests.
  RewriteRule ^\.well-known/ - [L]

  # The API lives inside the document root and routes itself.
  RewriteRule ^api/ - [L]

  # IMMUTABLE RELEASE ASSETS ARE NOT SPA ROUTES.
  #
  # Without this line a mistyped or missing asset under /releases/ is answered
  # with index.html and a 200, which the browser then tries to execute as
  # JavaScript. The failure that produces is a blank page with a syntax error,
  # which is about as far from its cause as an error can get. Let it 404.
  RewriteRule ^releases/ - [L]

  # Everything else is a client-side route, including /auth/callback.
  RewriteRule ^ index.html [L]
</IfModule>

# --- Caching ---------------------------------------------------------------
<IfModule mod_headers.c>
  # Release assets are addressed by commit and never change. Cache them hard.
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html must never be cached, or a deploy is invisible to clients and
  # they keep loading the previous release's assets by name.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# --- Hardening -------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # A mailbox has no business being framed by another site.
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "camera=(), geolocation=(), payment=()"
</IfModule>

# Deny access to any dotfile that somehow lands in the docroot (e.g. .env),
# except .well-known which must stay reachable for SSL renewal.
RedirectMatch 404 /\.(?!well-known)
